# Copy this file to .env for development and to .env.test for tests.

# PostgreSQL connection string.
# Development:
DATABASE_URL=postgresql://quizcraft:quizcraft@localhost:5432/quizcraft
# Tests (optional separate database):
# DATABASE_URL=postgresql://quizcraft:quizcraft@localhost:5432/quizcraft_test

# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Server port. Vite proxies /api to this port during development.
PORT=3000

# "development", "test" or "production". Jest sets NODE_ENV=test automatically.
NODE_ENV=development

# bcrypt cost. Leave at 10 for real use; tests use 4 to stay quick.
BCRYPT_ROUNDS=10
